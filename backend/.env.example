DATABASE_TYPE=SQLITE
DATABASE_URL=sqlite:///./data/inventory.db
SECRET_KEY=AUTO
# Alternatively use SECRET_KEY_FILE=/run/secrets/jwt_key and leave SECRET_KEY=AUTO.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=14400
# Set before the first startup; existing account passwords are unchanged.
ADMIN_PASSWORD=

# Optional Web Push: generate a P-256 PEM once, mount it persistently in API and worker.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=
WEB_PUSH_VAPID_SUBJECT=
