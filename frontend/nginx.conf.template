events {}

http {
  include       mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  server_tokens off;

  map "$request_uri:$status" $log_health_access {
    default 1;
    ~^/health-check(?:\?.*)?:200$ 0;
  }
  access_log /var/log/nginx/access.log combined if=$log_health_access;

  server {
    listen 80;
    server_name _;
    return 308 https://$host:${FRONTEND_HTTPS_PORT}$request_uri;
  }

  server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /run/frontend-tls/cert.pem;
    ssl_certificate_key /run/frontend-tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Usa il resolver DNS interno di Docker per ri-risolvere il nome del backend
    # ad ogni richiesta, evitando cache IP stale dopo restart del container
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /health-check {
      root /usr/share/nginx/html;
      try_files /index.html =503;
    }

    location / {
      root /usr/share/nginx/html;
      index index.html;
      try_files $uri $uri/ /index.html;
    }

    location /api/ {
      set $backend_upstream ${BACKEND_BASE_URL};
      rewrite ^/api/(.*) /$1 break;
      proxy_pass $backend_upstream;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}